#!/usr/bin/env zsh
# Post-init configuration script for Linux systems. This script is intended to be run as part of the Chezmoi configuration management process.

# Set the user's default shell to zsh if it is not already set. The current SHELL might be out of date, so we check the user's shell in /etc/passwd instead.
if [ "$(getent passwd $USER | cut -d: -f7)" != "/usr/bin/zsh" ]; then
    echo "Changing default shell to zsh for user $USER"
    chsh -s /usr/bin/zsh $USER
fi

# Configure mise
export MISE_VERSION={{ .versions.mise.value }}
if ! command -v mise >/dev/null 2>&1 || [[ "$(mise --version)" != "$MISE_VERSION" ]]; then
    echo "Installing mise version $MISE_VERSION"
    curl "https://mise.run" | sh
fi

# Install and enable the opencode user systemd service
OPENCODE_SERVICE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
OPENCODE_SERVICE_FILE="$OPENCODE_SERVICE_DIR/opencode.service"

mkdir -p "$OPENCODE_SERVICE_DIR"

cat > "$OPENCODE_SERVICE_FILE" <<'EOF'
[Unit]
Description=OpenCode serve
After=network.target

[Service]
ExecStart=%h/.local/share/mise/shims/opencode serve --port 4096
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now opencode.service
